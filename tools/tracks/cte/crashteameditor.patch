--- a/src/bsp.cpp
+++ b/src/bsp.cpp
@@ -1,6 +1,7 @@
 #include "bsp.h"
 #include "psx_types.h"
 
+#include <algorithm>
 #include <cstring>
 
 static size_t g_id = 0;
@@ -260,6 +261,25 @@ void BSP::Generate(const std::vector<Quadblock>& quadblocks, const size_t maxQua
 		m_flags &= ~BSPFlags::LEAF;
 	}
 
+	// Root only: drawn blocks and collision-only blocks (ground or wall flags) go in separate
+	// subtrees, so the collision subtree can be marked invisible in the visibility lists and the
+	// renderer never walks it.
+	if (m_parent == nullptr)
+	{
+		std::vector<size_t> drawn, collision;
+		for (size_t index : m_quadblockIndexes)
+		{
+			if (quadblocks[index].GetFlags() & (QuadFlags::GROUND | QuadFlags::WALL)) { collision.push_back(index); }
+			else { drawn.push_back(index); }
+		}
+		if (!drawn.empty() && !collision.empty())
+		{
+			m_axis = AxisSplit::Y;
+			GenerateOffspring(drawn, collision, quadblocks, maxQuadsPerLeaf, maxAxisLength);
+			return;
+		}
+	}
+
 	if (m_quadblockIndexes.size() == 1)
 	{
 		std::vector<size_t> empty = {};
@@ -355,7 +375,25 @@ float BSP::Split(std::vector<size_t>& left, std::vector<size_t>& right, const Ax
 			break;
 		}
 	}
-	if (left.empty() || right.empty()) { return std::numeric_limits<float>::max(); }
+	if (left.empty() || right.empty())
+	{
+		// One large quadblock can stretch the box while every centre sits on one side of
+		// its midpoint: split at the median centre instead.
+		std::vector<std::pair<float, size_t>> centres;
+		for (size_t index : m_quadblockIndexes)
+		{
+			const Vec3 c = quadblocks[index].GetCenter();
+			centres.emplace_back(axis == AxisSplit::X ? c.x : (axis == AxisSplit::Y ? c.y : c.z), index);
+		}
+		std::sort(centres.begin(), centres.end());
+		const size_t half = centres.size() / 2;
+		if (centres.size() < 2 || centres.front().first == centres.back().first)
+		{
+			return std::numeric_limits<float>::max();
+		}
+		left.clear(); right.clear();
+		for (size_t i = 0; i < centres.size(); i++) { (i < half ? right : left).push_back(centres[i].second); }
+	}
 	float perimeterLeft = ComputeBoundingBox(quadblocks, left).SemiPerimeter();
 	float perimeterRight = ComputeBoundingBox(quadblocks, right).SemiPerimeter();
 	return perimeterLeft + perimeterRight;
